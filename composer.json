{
    "name": "infrangible/m2-google-maps",
    "description": "Adds Google Maps widgets for CMS pages and blocks (map with one marker, map with a list of markers, address autocomplete) and address lookup via the Google Geocoding API.",
    "type": "magento2-module",
    "version": "2.0.2",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Integrations",
        "Content",
        "Hyvä",
        "Google Maps widget",
        "address autocomplete",
        "map with markers in CMS pages"
    ],
    "homepage": "https://www.infrangible.dev/modules/google-maps",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.1",
        "infrangible/m2-core": "~5.0.4",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-backend": "~102.0.0",
        "magento/module-cms": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-csp": "~100.4.0",
        "magento/module-widget": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0",
        "symfony/console": "~5.4.0||~6.4.0||~7.4.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\GoogleMaps\\": "src"
        }
    }
}
