use Infrangible\GoogleMaps\Block\Widget\GoogleMaps\Autocomplete;
use Magento\Framework\Escaper;

/** @var Autocomplete $block */
/** @var Escaper $escaper */

$inputId = $block->getInputId();
?>
<div class="google-maps-input">
    <label for="<?= $escaper->escapeHtmlAttr($inputId) ?>"><?= $escaper->escapeHtml(__('Location Search')) ?></label>
    <input type="text" name="<?= $escaper->escapeHtmlAttr($inputId) ?>" id="<?= $escaper->escapeHtmlAttr($inputId) ?>"
           value="<?= $escaper->escapeHtmlAttr((string)$block->getInputValue()) ?>" class="google-maps-input-text">
</div>
<!--suppress JSUnresolvedVariable, JSUnresolvedFunction -->
<script>
    document.addEventListener("google-maps-api", function () {
        new google.maps.places.Autocomplete(
            document.getElementById("<?= $escaper->escapeJs($inputId) ?>"),
            {
                types: ["geocode"],
                <?php /* the restrictions are JavaScript of the widget, entered in the admin */ ?>
                componentRestrictions: {<?= /* @noEscape */ $block->getComponentRestrictions() ?>}
            }
        );
    });
</script>
