use Infrangible\GoogleMaps\Block\Widget\GoogleMaps\JsonMarker;
use Magento\Framework\Escaper;

/** @var JsonMarker $block */
/** @var Escaper $escaper */

[$centerLatitude, $centerLongitude] = $block->getMapCenter();
?>
<?php $styles = implode(' ', array_filter([$block->getWidthStyle(), $block->getHeightStyle()])); ?>
<div id="<?= $escaper->escapeHtmlAttr($block->getMapId()) ?>" class="google-maps"
    <?php if ($styles !== ''): ?>style="<?= $escaper->escapeHtmlAttr($styles) ?>"<?php endif; ?>></div>
<!--suppress JSUnresolvedVariable, JSUnresolvedFunction -->
<script>
    document.addEventListener("google-maps-api", function () {
        const mapCenter = {
            lat: <?= /* @noEscape */ (float)$centerLatitude ?>,
            lng: <?= /* @noEscape */ (float)$centerLongitude ?>
        };
        const mapConfig = {
            center: mapCenter,
            zoomControl: <?= /* @noEscape */ $block->getZoomControl() ?>,
            mapTypeControl: <?= /* @noEscape */ $block->getMapTypeControl() ?>,
            streetViewControl: <?= /* @noEscape */ $block->getStreetViewControl() ?>,
            rotateControl: <?= /* @noEscape */ $block->getRotateControl() ?>,
            scaleControl: <?= /* @noEscape */ $block->getScaleControl() ?>,
            fullscreenControl: <?= /* @noEscape */ $block->getFullscreenControl() ?>
        };
        <?php if ($block->getZoom() !== null): ?>
        mapConfig.zoom = <?= /* @noEscape */ $block->getZoom() ?>;
        <?php endif; ?>

        const visibilities = {
            administrative: "<?= $escaper->escapeJs($block->getAdministrativeStyle()) ?>",
            landscape: "<?= $escaper->escapeJs($block->getLandscapeStyle()) ?>",
            poi: "<?= $escaper->escapeJs($block->getPOIStyle()) ?>",
            road: "<?= $escaper->escapeJs($block->getRoadStyle()) ?>",
            transit: "<?= $escaper->escapeJs($block->getTransitStyle()) ?>",
            water: "<?= $escaper->escapeJs($block->getWaterStyle()) ?>"
        };
        mapConfig.styles = Object.keys(visibilities).map(function (featureType) {
            return {featureType: featureType, stylers: [{visibility: visibilities[featureType]}]};
        });
        const map = new google.maps.Map(
            document.getElementById("<?= $escaper->escapeJs($block->getMapId()) ?>"),
            mapConfig
        );
        <?php /* JSON with escaped tags and quotes, safe in a script element */ ?>
        const locations = <?= /* @noEscape */ $block->getLocationsJson() ?>;

        locations.forEach(function (location) {
            const markerConfig = {position: new google.maps.LatLng(location.lat, location.lng), map};

            if (location.title) {
                markerConfig.title = location.title;
            }

            const marker = new google.maps.Marker(markerConfig);

            if (location.info_window) {
                const infoWindow = new google.maps.InfoWindow({content: location.info_window});

                marker.addListener("click", function () {
                    infoWindow.open({anchor: marker, map, shouldFocus: false});
                });
            }
        });
    });
</script>
